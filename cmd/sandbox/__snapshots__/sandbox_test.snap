
[TestPrepareSandbox - 1]
[]string{"admin", "ca.pem", "cert.pem", "client", "key.pem", "passwords.conf"}
файл настроек клиента записан: "<host>/gophkeeper/config.yaml"
файл настроек "<host>/gophkeeper/config.yaml" уже содержит эти настройки
# gophkeeper-sandbox: файл записан командой sandbox, повторный запуск его заменяет
server: https://project.supabase.co
app_key: ЗАГЛУШКА КЛЮЧА
queue: tls://127.0.0.1:54222
queue_user: client
queue_password: <client>
queue_inbox: _INBOX.pub
queue_ca: |
    <ca>

ADMIN_PASSWORD: "<admin>"
CLIENT_PASSWORD: "<client>"

---

[TestPrepareSandboxForeign - 1]
в "<host>/gophkeeper/config.yaml" другие настройки, клиент продолжит работать с ними. Новые настройки лежат в "<host>/gophkeeper/config.sandbox.yaml"

[TestModelServices - 5]
include "sandbox/passwords.conf"
server_name: gophkeeper-sandbox
listen: 0.0.0.0:4222
http: 127.0.0.1:8222
tls {
  cert_file: /etc/nats/sandbox/cert.pem
  key_file: /etc/nats/sandbox/key.pem
  timeout: 3
}
jetstream {
  store_dir: /data
}
authorization {
  timeout: 3
  users: [
    {user: admin, password: $$ADMIN_PASSWORD}
    {user: client, password: $$CLIENT_PASSWORD, permissions: {
      publish: {allow: ["changes.>"]}
      subscribe: {allow: ["_INBOX.pub.>"]}
    }}
  ]
}

---

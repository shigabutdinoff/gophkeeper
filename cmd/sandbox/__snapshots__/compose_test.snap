[]string(nil)
[]string{"sh", "-c", "rm -f /tmp/ready && export NATS_PASSWORD=\"$$(cat /sandbox/admin)\" && stream=\"$$(jq -r .name /etc/nats/stream.json)\" && { nats stream info \"$$stream\" >/dev/null 2>&1 || nats stream add \"$$stream\" --config /etc/nats/stream.json; } && touch /tmp/ready && exec tail -f /dev/null"}
